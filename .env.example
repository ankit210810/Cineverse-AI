# =====================================================================
# CINEVERSE AI — ENVIRONMENT CONFIGURATION TEMPLATE
# =====================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
# Or configure these in Streamlit Community Cloud under Advanced Settings > Secrets.
#
# IMPORTANT:
# - Never commit your actual .env file or credentials to Git/GitHub.
# - The application will run gracefully in Offline/Local mode if Supabase or TMDB
#   keys are not yet provided.
# =====================================================================

# ---------------------------------------------------------------------
# 1. SUPABASE CONFIGURATION (Authentication & Production PostgreSQL)
# ---------------------------------------------------------------------
# Found in Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://your-project-id.supabase.co
# Project API Key: Anon / Public Key (Safe for client initialization)
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-anon-key
# Project API Key: Service Role / Secret Key (Keep strictly server-side for admin bootstrap)
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key

# ---------------------------------------------------------------------
# 2. THE MOVIE DATABASE (TMDB) API KEY
# ---------------------------------------------------------------------
# Found in TMDB Account Settings > API (v3 auth)
TMDB_API_KEY=your-tmdb-api-key-v3
