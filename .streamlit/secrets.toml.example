# =====================================================================
# CINEVERSE AI — STREAMLIT SECRETS TEMPLATE
# =====================================================================
# For Local Development:
# Copy this file to .streamlit/secrets.toml:
#   cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#
# For Streamlit Community Cloud Deployment:
# Paste these key-value pairs into the Streamlit Cloud Dashboard under:
#   App Settings > Secrets
#
# DO NOT COMMIT THE ACTUAL secrets.toml FILE TO GITHUB!
# =====================================================================

# Supabase Production Authentication & PostgreSQL (Found in Supabase Dashboard > Settings > API)
SUPABASE_URL = "https://your-project-id.supabase.co"
SUPABASE_PUBLISHABLE_KEY = "your-supabase-publishable-anon-key"
SUPABASE_SECRET_KEY = "your-supabase-service-role-secret-key"

# Optional TMDB API Key for dynamic poster queries (Found in TMDB Settings > API)
TMDB_API_KEY = "your-tmdb-api-key-v3"
